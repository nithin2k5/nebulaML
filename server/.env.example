# MySQL Database Configuration
# Configure these values according to your MySQL setup
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yolo_generator
# Pooled connections per API process. Keep at or below the MySQL server's
# max_connections divided by the number of processes.
DB_POOL_SIZE=10

# JWT Secret Key
# IMPORTANT: Change this to a secure random string in production!
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# Access token lifetime, in minutes. Short on purpose: the token is readable by
# any script on the page, so this bounds how long a stolen one is useful. The
# refresh token below carries the long session.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token lifetime, in days. Rotated on every use, with reuse detection.
REFRESH_TOKEN_EXPIRE_DAYS=7

# Send Strict-Transport-Security. Leave false for local http development —
# it pins the browser to https://localhost, which then refuses to connect.
ENABLE_HSTS=false

# SMTP Configuration (for Magic Link/OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
